APP_NAME="My App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TENANT_CANONICAL_URL=
# Optional multi-tenant map: {"tenant_a":{"canonical_url":"https://example.com","aliases":["www.example.com"]}}
TENANT_CANONICAL_DOMAINS={}

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

LOG_CHANNEL="stack"
LOG_LEVEL="error"
DB_CONNECTION=null
DB_DATABASE=":memory:"
BROADCAST_DRIVER="log"
CACHE_DRIVER="file"
SESSION_DRIVER="file"
SESSION_LIFETIME="120"
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD="null"
REDIS_PORT="6379"
MAIL_MAILER="smtp"
MAIL_HOST="mailpit"
MAIL_PORT="1025"
MAIL_USERNAME="null"
MAIL_PASSWORD="null"
MAIL_ENCRYPTION="null"
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
PUSHER_APP_ID=""
PUSHER_APP_KEY=""
PUSHER_APP_SECRET=""
PUSHER_HOST=""
PUSHER_PORT="443"
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="mt1"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Tenant API (Laravel ana proje). config:cache sonrası uygulama kodunda env() kullanılmaz — sadece buradan okunur.
OMR_API_BASE="https://omerdogan.de/api"
# Tenant JSON API sürümü. Uygulama yalnızca v2 kullanır.
OMR_API_VERSION=2
OMR_API_CONNECT_TIMEOUT="5"
OMR_API_TIMEOUT="20"
OMR_API_RETRY_COUNT="1"
OMR_API_RETRY_SLEEP="500"
OMR_API_FAILURE_COOLDOWN="300"
OMR_ANALYTICS_ENABLED=true
OMR_PAGE_TIMING_ENABLED=true
OMR_ANALYTICS_THROTTLE_SECONDS=3600
OMR_TENANT_ID=""
# OMR_TENANT_ID boşsa kullanılan yedek (isteğe bağlı)
OMR_TENANT_ID_FALLBACK="oi_clean_groupde_693fac5831392"
OMR_MAIN_TENANT=""
OMR_DEFAULT_LOCALE="de"

# İlk HTML ziyaretinden sonra pages/catalog/media cache'lerini bir kez hazırlar.
# Panelde içerik değişince POST /api/omr/cache-changed endpointini bu secret ile çağırın.
OMR_AUTO_WARMUP=true
OMR_AUTO_WARM_MEDIA=true
OMR_WARMUP_VERSION=1
OMR_WARMUP_SOURCE_LOCALE=de
OMR_WARMUP_MAX_PAGES=120
OMR_WARMUP_PER_PAGE=100
OMR_WARMUP_SLEEP_MS=2500
OMR_WARMUP_LIMIT_CATEGORIES=1
OMR_WARMUP_WEBHOOK_SECRET=

OMR_MENU_ENDPOINT="null"
DASHBOARD_API_URL="null"
DASHBOARD_API_KEY="null"
DASHBOARD_SITE_ID="null"
DASHBOARD_CACHE_TTL="3600"
VITE_REMOTE_API_BASE="null"
VITE_REMOTE_MENU_ENDPOINT="null"
VITE_REMOTE_TIMEOUT="10000"
VITE_REMOTE_TENANT_ID="null"
VITE_API_BASE_URL="null"
# Tarayıcı tarafındaki OMR API sürümü; backend ile aynı v2 değerini kullanır.
VITE_OMR_API_BASE="https://omerdogan.de/api"
VITE_OMR_API_VERSION="v2"

VITE_TENANT_CITY=Baden-Württemberg
VITE_TENANT_DISTRICT=Baden-Württemberg
VITE_TENANT_STATE_CODE=DE-BW

# Merkez (Stuttgart civarı)
VITE_TENANT_CENTER_LNG=9.0000
VITE_TENANT_CENTER_LAT=48.5000

# Zoom (denge)
VITE_TENANT_SCALE_DESKTOP=7500
VITE_TENANT_SCALE_MOBILE=9500

# Media mirror (görsel cache)
MEDIA_MIRROR_ENABLED=true
MEDIA_MIRROR_REMOTE_BASE=https://omerdogan.de
MEDIA_MIRROR_CARD_WIDTH=480
MEDIA_MIRROR_MAX_WIDTH=1200

# Otomatik güncelleme (GitHub → sunucu)
UPDATE_ENABLED=false
UPDATE_SECRET=
GITHUB_REPO_OWNER=Oi2024
GITHUB_REPO_NAME=oicleanfront
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Git yoksa GitHub zipball ile güncelle (FTP siteler için)
UPDATE_ARCHIVE_FALLBACK=true
UPDATE_PHP_CLI=
UPDATE_COMPOSER_BIN=/usr/bin/composer
UPDATE_RUN_COMPOSER=true
# Sunucuda npm yok — build GitHub'da alınır, sunucu sadece git pull yapar
UPDATE_RUN_NPM=false
UPDATE_RUN_BUILD=false
UPDATE_RUN_MEDIA_SYNC=false
# UPDATE_ALLOWED_IPS=1.2.3.4

# Remote artisan endpoint

SITEMAP_SOURCE=cache
